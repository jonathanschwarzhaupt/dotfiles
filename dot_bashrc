# ~~~~~~~~~~~~~~~ Interactive check ~~~~~~~~~~~~~~~~~~~~~~~~
# Bash sources ~/.bashrc for every non-login interactive shell, including
# ones spawned by scripts. Bail out early if this isn't interactive so
# nothing below (prompt, completion, aliases) runs where it shouldn't.
# (This was almost certainly already at the top of your stock bashrc.)

[[ $- != *i* ]] && return


# ~~~~~~~~~~~~~~~ History ~~~~~~~~~~~~~~~~~~~~~~~~


HISTFILE="$HOME/.bash_history"
HISTSIZE=100000       # zsh: HISTSIZE  (lines kept in memory)
HISTFILESIZE=100000   # zsh: SAVEHIST  (lines kept in the history file)

# bash doesn't dedupe/append like zsh does by default, so mirror that here:
HISTCONTROL=ignoredups:erasedups   # don't record duplicate lines
shopt -s histappend                # append to HISTFILE, don't overwrite it
# re-read history after every command so multiple open shells share it,
# similar to zsh's SHARE_HISTORY/INC_APPEND_HISTORY if you used those
PROMPT_COMMAND="history -a; history -c; history -r${PROMPT_COMMAND:+; $PROMPT_COMMAND}"


# ~~~~~~~~~~~~~~~ Prompt ~~~~~~~~~~~~~~~~~~~~~~~~

# 'pure' is a zsh-only prompt (it hooks into zsh's prompt/fpath system), so
# there's no direct bash port. Using starship instead with its built-in
# "Pure Preset", which is designed to look and behave like the pure prompt:
#
#   One-time setup (after installing starship via mise, see below):
#     starship preset pure-preset -o ~/.config/starship.toml
#
# https://starship.rs/presets/pure-preset

if command -v starship > /dev/null ; then
  eval "$(starship init bash)"
fi

# enable bash vi-mode
set -o vi
# zsh's KEYTIMEOUT=1 (10ms) made mode-switching snappy; this is bash's
# readline equivalent, in milliseconds
bind 'set keyseq-timeout 10'


# ~~~~~~~~~~~~~~~ Environment Variables ~~~~~~~~~~~~~~~~~~~~~~~~


if command -v nvim > /dev/null ; then
  export EDITOR="nvim"
  export VISUAL="nvim"
fi

export LANG="en_US.UTF-8"


# ~~~~~~~~~~~~~~~ Mise ~~~~~~~~~~~~~~~~~~~~~~~~


if command -v mise > /dev/null ; then
  eval "$($HOME/.local/bin/mise activate bash)"
elif [[ -f "$HOME/.local/bin/mise" ]]; then
  eval "$($HOME/.local/bin/mise activate bash)"
fi


# ~~~~~~~~~~~~~~~ Completion ~~~~~~~~~~~~~~~~~~~~~~~~

# zsh's compinit has no bash equivalent; bash's completion system comes from
# the bash-completion package instead. On Arch it's usually auto-sourced by
# /etc/bash.bashrc, but load it explicitly here in case this file is ever
# used standalone (e.g. via chezmoi on a minimal box).
if [[ -f /usr/share/bash-completion/bash_completion ]]; then
  source /usr/share/bash-completion/bash_completion
fi

if command -v fzf > /dev/null ; then
  source <(fzf --bash)
fi

if command -v kubectl > /dev/null ; then
  source <(kubectl completion bash)
fi

if command -v flux > /dev/null ; then
  source <(flux completion bash)
fi

if command -v mise > /dev/null ; then
  source <(mise completion bash)
fi


# ~~~~~~~~~~~~~~~ Aliases ~~~~~~~~~~~~~~~~~~~~~~~~


alias v=nvim
alias z=zed
alias k=kubectl
alias gp="git pull"
alias gs="git status"
alias lg=lazygit
alias tf=terraform

if command -v bat > /dev/null ; then
  alias cat="bat"
fi

if command -v lsd > /dev/null ; then
  alias ls="lsd"
  alias ll="ls -lgh"
  alias la='ls -lathr'
  alias lla='ls -lgha'
  alias lt='ls --tree'
fi
